# Copy this file to ".env" (same folder as server.py) to turn on the optional live video avatar.
# Everything here is free and open source. No API keys, no credits.
#
# Address of a LiveTalking server you run yourself (see LIVE-AVATAR.md).
# Leave it empty or delete the line to use only the built-in animated-photo avatar.
LIVETALKING_URL=http://127.0.0.1:8010
